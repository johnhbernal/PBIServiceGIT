{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "DataProvider": "InMemory",
    "InMemoryDatabaseName": "PBITeachingDb",
    "TeachingLab": true
  },
  "ConnectionStrings": {
    "InventoryDatabase": "TEACHING-ONLY-DO-NOT-USE-REAL-SQL",
    "VendedoresDatabase": "TEACHING-ONLY-DO-NOT-USE-REAL-SQL"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "PBIServices-Teaching",
    "Audience": "PBIServices-Teaching-Client",
    "Subject": "PBIServicesAccessToken",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000"
  },
  "Ldap": {
    "Path": "SIMULATED://demo.local/",
    "UserDomainName": "OU=Teaching,DC=demo,DC=local",
    "Enabled": true,
    "RequireBind": false,
    "Mode": "Simulated"
  }
}
