# Teaching lab — no corporate hosts, no real passwords.
# Optional overrides (defaults already work offline with InMemory + seed).

ASPNETCORE_ENVIRONMENT=Development
App__DataProvider=InMemory
Jwt__Key=teaching-only-jwt-key-min-32-chars-demo!!
Cors__AllowedOrigins=http://localhost:3000
Ldap__Mode=Simulated
Ldap__Enabled=true
